{
  "name": "resonant-field",
  "version": "0.1.0",
  "private": true,
  "description": "Shared knowledge graph, retrieval, and context engine for Resonant Assist projects.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && node scripts/validate-repo.mjs"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
