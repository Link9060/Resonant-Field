{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resonant.ai/schemas/field/knowledge-edge.schema.json",
  "title": "KnowledgeEdge",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "ownerId", "sourceNodeId", "targetNodeId", "relationType", "strength", "origin", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "ownerId": { "type": "string", "minLength": 1 },
    "sourceNodeId": { "type": "string", "minLength": 1 },
    "targetNodeId": { "type": "string", "minLength": 1 },
    "relationType": { "type": "string", "minLength": 1 },
    "strength": { "type": "number", "minimum": 0, "maximum": 1 },
    "origin": { "enum": ["user", "system", "ravin"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
